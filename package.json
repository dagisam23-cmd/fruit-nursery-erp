{
  "name": "fruit-nursery-erp",
  "version": "1.0.0",
  "description": "Enterprise Resource Planning Platform for Commercial Fruit Nurseries",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "build": "npm run build:api && npm run build:web && npm run build:mobile",
    "build:api": "tsc --project tsconfig.json",
    "build:web": "cd apps/web && npm run build",
    "build:mobile": "cd apps/mobile && npm run build",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed:db": "knex seed:run"
  },
  "keywords": ["ERP", "Nursery", "Agriculture", "Production"],
  "author": "Fruit Nursery Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "typescript": "^5.0.0",
    "dotenv": "^16.0.3",
    "postgresql": "^2.0.0",
    "knex": "^2.5.1",
    "pg": "^8.10.0",
    "joi": "^17.9.2",
    "jwt-decode": "^3.1.2",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "redis": "^4.6.5",
    "bull": "^4.10.4",
    "winston": "^3.8.2",
    "uuid": "^9.0.0",
    "axios": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.17",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "nodemon": "^2.0.22",
    "eslint": "^8.40.0",
    "@typescript-eslint/eslint-plugin": "^5.59.6",
    "@typescript-eslint/parser": "^5.59.6"
  }
}
